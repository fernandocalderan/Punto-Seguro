    "lead_submit_success",
    "lead_submit_error"
  ],
  "trackingAttrs": [
    "data-ps-placement",
    "data-ps-segment"
  ],
  "sourceSnippets": [
    "select[data-qid]",
    "document.getElementById(\"risk-explanation\")",
    "document.getElementById(\"decision-feedback\")",
    "onsubmit=\"event.preventDefault(); calcularRiesgo();\"",
    "onchange=\"cambiarFormulario(this.value)\""
  ],
