  "apiContracts": [
    { "method": "POST", "path": "/api/events" },
    { "method": "POST", "path": "/api/eval-snapshot" },
    { "method": "GET", "path": "/api/eval-snapshot/me" },
    { "method": "POST", "path": "/api/otp/start" },
    { "method": "POST", "path": "/api/otp/check" },
    { "method": "POST", "path": "/api/otp/token" },
    { "method": "POST", "path": "/api/leads" }
  ],
  "apiProbes": [
    {
      "method": "POST",
      "path": "/api/events",
      "body": {},
      "expectedStatuses": [400]
    },
    {
      "method": "GET",
      "path": "/api/eval-snapshot/me",
      "expectedStatuses": [200, 404]
    },
    {
      "method": "POST",
      "path": "/api/otp/start",
      "body": { "phone": "123" },
      "expectedStatuses": [400]
    },
    {
      "method": "POST",
      "path": "/api/otp/check",
      "body": { "phone": "123", "code": "00" },
      "expectedStatuses": [400]
    },
    {
      "method": "POST",
      "path": "/api/otp/token",
      "body": { "phone": "123" },
      "expectedStatuses": [400]
    },
    {
      "method": "POST",
      "path": "/api/leads",
      "body": {},
      "expectedStatuses": [400, 403, 500]
    }
  ],
  "trackingEvents": [
    "quiz_started",
    "quiz_completed",
    "result_viewed",
    "cta_proposals_click",
    "lead_declined",
    "cta_diagnostico_clicked",
